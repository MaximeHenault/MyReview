{% extends 'base.html.twig' %}

{% block title %}Accueil | MyReview{% endblock %}

{% block body %}
    {% include "topbar.html.twig" %}

    <style>
        .home-wrap {
            width: min(1200px, calc(100% - 2rem));
            margin: 1.2rem auto 2rem;
            display: grid;
            gap: 1rem;
        }

        .home-hero {
            padding: clamp(1.2rem, 3.4vw, 2.6rem);
            border-radius: 1.2rem;
            border: 1px solid rgba(255, 255, 255, 0.12);
            background:
                radial-gradient(420px 250px at 82% 25%, rgba(69, 211, 122, 0.24), transparent 72%),
                linear-gradient(125deg, rgba(25, 25, 29, 0.96), rgba(16, 16, 18, 0.96));
            box-shadow: 0 25px 45px rgba(0, 0, 0, 0.32);
            position: relative;
            overflow: hidden;
        }

        .home-hero::after {
            content: "";
            position: absolute;
            inset: auto -90px -90px auto;
            width: 220px;
            height: 220px;
            border-radius: 999px;
            background: radial-gradient(circle, rgba(69, 211, 122, 0.38), transparent 70%);
            pointer-events: none;
        }

        .home-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.4rem;
            border-radius: 999px;
            padding: 0.28rem 0.7rem;
            border: 1px solid rgba(255, 255, 255, 0.15);
            background: rgba(255, 255, 255, 0.06);
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            font-weight: 700;
        }

        .home-title {
            margin: 0.75rem 0 0.45rem;
            font-size: clamp(1.8rem, 4.3vw, 3.25rem);
            text-transform: uppercase;
            line-height: 1.04;
        }

        .home-title-accent {
            color: var(--mr-primary);
        }

        .home-lead {
            color: var(--mr-text-soft);
            max-width: 68ch;
            margin-bottom: 1rem;
        }

        .home-actions {
            display: flex;
            gap: 0.65rem;
            flex-wrap: wrap;
        }

        .home-kpis {
            display: grid;
            gap: 0.8rem;
            grid-template-columns: repeat(4, minmax(0, 1fr));
        }

        .home-kpi {
            border-radius: 0.9rem;
            border: 1px solid rgba(255, 255, 255, 0.08);
            background: linear-gradient(180deg, rgba(255, 255, 255, 0.06), rgba(255, 255, 255, 0.02));
            padding: 0.8rem;
            text-align: center;
        }

        .home-kpi-num {
            display: block;
            font-family: "Barlow", sans-serif;
            font-size: 1.35rem;
            font-weight: 800;
            color: #fff;
        }

        .home-kpi-label {
            color: var(--mr-text-soft);
            text-transform: uppercase;
            font-size: 0.72rem;
            letter-spacing: 0.04em;
            font-weight: 700;
        }

        .home-grid {
            display: grid;
            gap: 1rem;
            grid-template-columns: 1.2fr 1fr;
        }

        .home-panel {
            border-radius: 1rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: linear-gradient(180deg, rgba(24, 24, 27, 0.96), rgba(15, 15, 17, 0.96));
            padding: 1rem;
        }

        .home-panel h2 {
            font-size: 1.2rem;
            text-transform: uppercase;
            margin-bottom: 0.8rem;
        }

        .home-cats {
            display: grid;
            gap: 0.75rem;
        }

        .home-cat {
            display: grid;
            grid-template-columns: auto 1fr auto;
            align-items: center;
            gap: 0.75rem;
            padding: 0.75rem;
            border-radius: 0.8rem;
            text-decoration: none;
            color: #fff;
            border: 1px solid rgba(255, 255, 255, 0.08);
            background: rgba(255, 255, 255, 0.04);
            transition: transform 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
        }

        .home-cat:hover {
            transform: translateY(-2px);
            border-color: rgba(69, 211, 122, 0.45);
            background: rgba(69, 211, 122, 0.12);
            color: #fff;
        }

        .home-cat i:first-child {
            font-size: 1.2rem;
            color: var(--mr-primary);
        }

        .home-cat strong {
            display: block;
            font-size: 0.95rem;
            text-transform: uppercase;
        }

        .home-cat span {
            color: var(--mr-text-soft);
            font-size: 0.83rem;
        }

        .home-steps {
            display: grid;
            gap: 0.7rem;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .home-step {
            display: grid;
            grid-template-columns: 30px 1fr;
            gap: 0.7rem;
            align-items: start;
        }

        .home-step-index {
            width: 30px;
            height: 30px;
            border-radius: 999px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
            background: rgba(69, 211, 122, 0.2);
            color: #d7ffe6;
            border: 1px solid rgba(69, 211, 122, 0.38);
        }

        .home-step p {
            margin: 0;
            color: var(--mr-text-soft);
            font-size: 0.92rem;
        }

        .home-footer-cta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 0.8rem;
            flex-wrap: wrap;
            padding: 0.95rem 1rem;
            border-radius: 0.95rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
            background: linear-gradient(90deg, rgba(69, 211, 122, 0.14), rgba(255, 255, 255, 0.03));
        }

        .home-footer-cta p {
            margin: 0;
            color: var(--mr-text-soft);
        }

        @media (max-width: 991px) {
            .home-kpis {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .home-grid {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 576px) {
            .home-kpis {
                grid-template-columns: 1fr;
            }
        }
    </style>

    <main class="home-wrap">
        <section class="home-hero">
            <span class="home-badge"><i class="bi bi-lightning-charge-fill"></i> MyReview Platform</span>
            <h1 class="home-title">
                L'endroit pour <span class="home-title-accent">noter</span> ton univers audiovisuel
            </h1>
            <p class="home-lead">
                Films, series et animes dans un seul espace. Tu ajoutes, tu notes, tu compares, et tu gardes une vraie memoire de tes coups de coeur.
            </p>
            <div class="home-actions">
                <a class="btn btn-primary" href="{{ path('app_film') }}"><i class="bi bi-film me-1"></i>Voir les films</a>
                <a class="btn btn-outline-light" href="{{ path('app_serie') }}"><i class="bi bi-collection-play me-1"></i>Voir les series</a>
                <a class="btn btn-outline-light" href="{{ path('app_anime') }}"><i class="bi bi-stars me-1"></i>Voir les animes</a>
            </div>
        </section>

        <section class="home-kpis">
            <article class="home-kpi">
                <span class="home-kpi-num">{{ films }}</span>
                <span class="home-kpi-label">films</span>
            </article>
            <article class="home-kpi">
                <span class="home-kpi-num">{{ series }}</span>
                <span class="home-kpi-label">séries</span>
            </article>
            <article class="home-kpi">
                <span class="home-kpi-num">{{ animes }}</span>
                <span class="home-kpi-label">animés</span>
            </article>
            <article class="home-kpi">
                <span class="home-kpi-num">{{ notes }}</span>
                <span class="home-kpi-label">notes</span>
            </article>
        </section>

        <section class="home-grid">
            <article class="home-panel">
                <h2>Explorer le catalogue</h2>
                <div class="home-cats">
                    <a href="{{ path('app_film') }}" class="home-cat">
                        <i class="bi bi-camera-reels-fill"></i>
                        <div>
                            <strong>Films</strong>
                            <span>Classe les sorties et tes classiques</span>
                        </div>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                    <a href="{{ path('app_serie') }}" class="home-cat">
                        <i class="bi bi-tv-fill"></i>
                        <div>
                            <strong>Series</strong>
                            <span>Suivi des saisons et progression</span>
                        </div>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                    <a href="{{ path('app_anime') }}" class="home-cat">
                        <i class="bi bi-lightning-fill"></i>
                        <div>
                            <strong>Animes</strong>
                            <span>Top shonen, seinen et pépites</span>
                        </div>
                        <i class="bi bi-chevron-right"></i>
                    </a>
                </div>
            </article>

            <article class="home-panel">
                <h2>Comment ca marche</h2>
                <ol class="home-steps">
                    <li class="home-step">
                        <span class="home-step-index">1</span>
                        <p>Cree ton compte, puis ajoute une oeuvre depuis la section qui t'interesse.</p>
                    </li>
                    <li class="home-step">
                        <span class="home-step-index">2</span>
                        <p>Attribue ta note et garde une vue claire de ce que tu as deja vu.</p>
                    </li>
                    <li class="home-step">
                        <span class="home-step-index">3</span>
                        <p>Compare les titres les mieux notes et construis ton propre top.</p>
                    </li>
                </ol>
            </article>
        </section>

        <section class="home-footer-cta">
            <p>Tu veux contribuer a la base maintenant ? Lance ton premier ajout.</p>
            <a href="{{ path('app_film_add') }}" class="btn btn-primary"><i class="bi bi-plus-circle me-1"></i>Ajouter un contenu</a>
        </section>
    </main>
{% endblock %}
