{% extends 'base.html.twig' %}

{% block title %}Details - {{ audiovisuel.titre }}{% endblock %}

{% block body %}
    {% include "topbar.html.twig" %}

    <style>
        .mr-detail-layout {
            display: grid;
            gap: 1rem;
            grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
            align-items: start;
        }

        .mr-detail-card {
            padding: 1rem;
        }

        .mr-detail-poster {
            width: 100%;
            height: clamp(280px, 48vw, 520px);
            object-fit: cover;
            border-radius: 0.9rem;
            border: 1px solid rgba(255, 255, 255, 0.1);
        }

        .mr-detail-title {
            margin-bottom: 0.3rem;
            font-size: clamp(1.35rem, 3vw, 2.1rem);
            text-transform: uppercase;
        }

        .mr-detail-meta {
            display: flex;
            gap: 0.45rem;
            flex-wrap: wrap;
            margin-bottom: 0.9rem;
        }

        .mr-detail-chip {
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            font-size: 0.78rem;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            font-weight: 700;
            color: #d5f8e4;
            background: rgba(69, 211, 122, 0.14);
            border: 1px solid rgba(69, 211, 122, 0.35);
            border-radius: 999px;
            padding: 0.28rem 0.62rem;
        }

        .mr-detail-text {
            color: var(--mr-text-soft);
            margin-bottom: 1rem;
            line-height: 1.55;
        }

        .mr-season-list {
            margin: 0;
            padding-left: 1.1rem;
            color: var(--mr-text-soft);
        }

        .mr-review-list {
            margin-top: 1rem;
            display: grid;
            gap: 0.7rem;
        }

        .mr-review-item {
            border: 1px solid rgba(255, 255, 255, 0.1);
            border-radius: 0.85rem;
            background: rgba(255, 255, 255, 0.03);
            padding: 0.75rem;
        }

        .mr-review-head {
            display: flex;
            justify-content: space-between;
            gap: 0.7rem;
            flex-wrap: wrap;
            margin-bottom: 0.35rem;
        }

        .mr-review-name {
            font-weight: 700;
        }

        .mr-review-date {
            color: var(--mr-text-soft);
            font-size: 0.82rem;
        }

        .mr-review-stars {
            color: #9ff1bf;
            margin-bottom: 0.35rem;
        }

        .mr-review-comment {
            color: var(--mr-text-soft);
            margin-bottom: 0.55rem;
        }

        .mr-review-actions {
            display: flex;
            gap: 0.45rem;
            flex-wrap: wrap;
        }

        @media (max-width: 992px) {
            .mr-detail-layout {
                grid-template-columns: 1fr;
            }
        }
    </style>

    <main class="mr-page">
        <section class="mr-detail-layout">
            <article class="mr-panel mr-detail-card">
                <img src="{{ audiovisuel.affiche }}" alt="Affiche de {{ audiovisuel.titre }}" class="mr-detail-poster">
            </article>

            <article class="mr-panel mr-detail-card">
                <h1 class="mr-detail-title">{{ audiovisuel.titre }}</h1>
                <div class="mr-detail-meta">
                    {% if audiovisuel.duree %}
                        <span class="mr-detail-chip"><i class="bi bi-clock"></i>{{ audiovisuel.duree // 60 }}h{{ "%02d"|format(audiovisuel.duree % 60) }}</span>
                    {% endif %}
                    {% if audiovisuel.date_creation %}
                        <span class="mr-detail-chip"><i class="bi bi-calendar-event"></i>{{ audiovisuel.date_creation|date('d/m/Y') }}</span>
                    {% endif %}
                    {% if audiovisuel.realisateur %}
                        <span class="mr-detail-chip"><i class="bi bi-person-video2"></i>{{ audiovisuel.realisateur }}</span>
                    {% endif %}
                </div>
                <p class="mr-detail-text">{{ audiovisuel.description|default('Aucune description disponible pour le moment.') }}</p>

                {% if is_granted('IS_AUTHENTICATED_FULLY') %}
                    <a href="{{ path('app_avis', { id: audiovisuel.id }) }}" class="btn btn-primary btn-sm">
                        <i class="bi bi-star-half me-1"></i>Noter ce titre
                    </a>
                {% endif %}

                {% if saisons is defined and saisons is not empty %}
                    <hr class="my-3">
                    <h2 class="h5 mb-2">Saisons</h2>
                    <ul class="mr-season-list">
                        {% for saison in saisons %}
                            <li>Saison {{ saison.numero }}{% if saison.titre %} - {{ saison.titre }}{% endif %}{% if saison.nb_episode %} ({{ saison.nb_episode }} episodes){% endif %}</li>
                        {% endfor %}
                    </ul>
                {% endif %}
            </article>
        </section>

        <section class="mr-panel p-3 mt-3">
            <h2 class="h4 mb-1">Avis utilisateurs</h2>
            <p class="mr-subheading mb-0">Retours de la communaute sur ce titre.</p>

            {% if notes is not empty %}
                <div class="mr-review-list">
                    {% for note in notes %}
                        <article class="mr-review-item">
                            <div class="mr-review-head">
                                <span class="mr-review-name">{{ note.utilisateur }}</span>
                                <span class="mr-review-date">{{ note.date_creation }}</span>
                            </div>
                            <div class="mr-review-stars">
                                {% for i in 0..4 %}
                                    {% if note.note >= i + 1 %}
                                        <i class="bi bi-star-fill"></i>
                                    {% elseif note.note >= i + 0.5 %}
                                        <i class="bi bi-star-half"></i>
                                    {% else %}
                                        <i class="bi bi-star"></i>
                                    {% endif %}
                                {% endfor %}
                            </div>
                            <p class="mr-review-comment">{{ note.commentaire|default('Sans commentaire.') }}</p>

                            {% if is_granted('IS_AUTHENTICATED_FULLY') and note.utilisateur_id == app.user.id %}
                                <div class="mr-review-actions">
                                    <a href="{{ path('app_avis_edit', { id: note.id }) }}" class="btn btn-outline-light btn-sm">Modifier</a>
                                    <form method="post" action="{{ path('app_avis_delete', { id: note.id }) }}" class="m-0">
                                        <input type="hidden" name="_token" value="{{ csrf_token('delete_avis_' ~ note.id) }}">
                                        <button type="submit" class="btn btn-outline-danger btn-sm" onclick="return confirm('Supprimer cet avis ?');">Supprimer</button>
                                    </form>
                                </div>
                            {% endif %}
                        </article>
                    {% endfor %}
                </div>
            {% else %}
                <p class="mt-3 mb-0 mr-subheading">Aucun avis pour le moment.</p>
            {% endif %}
        </section>
    </main>
{% endblock %}
